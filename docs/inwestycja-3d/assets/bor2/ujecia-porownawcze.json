{
 "opis": "Stały zestaw ujęć porównawczych BOR2 ↔ rendery/zdjęcia dewelopera (test odbioru wyglądu). Każde ujęcie: jawna poza kamery w układzie GLB, gotowa do odtworzenia w three.js.",
 "data": "2026-11-04",
 "autor": "sesja 3d-kamil-e3 (kontrola wizualna)",
 "uklad": "glTF Y-up, metry, wspólny dla bor2-zewnetrze / dom1 / dom2. Oś X = geograficzny wschód (georeferencja OSM, b6), −Z = północ (ulica), +Z = południe (ogrody). Kamery ręczne estate-* dopasowano wizualnie — ich jawne pozycje nie zależą od konwencji azymutu.",
 "domy": {
  "G": "DOM_G w v5 — domki__Component#40 (szereg zach., x 33,4–41,0) = dom1 wnętrz",
  "F": "DOM_F w v5 — domki__Component#39 (szereg środk., x 40,9–48,5)",
  "E": "DOM_E w v5 — domki__Component#35 (szereg wsch., x 48,4–56,0)",
  "D": "DOM_D w v5 — domki__Component#94 (bliźniak 1 zach., x 65,6–73,8)",
  "C": "DOM_C w v5 — domki__Component#119 (bliźniak 1 wsch., x 73,8–82,0)",
  "B": "DOM_B w v5 — domki__Component#57 (bliźniak 2 zach., x 91,6–99,8) = dom2 wnętrz",
  "A": "DOM_A w v5 — domki__Component#88_1..8 (bliźniak 2 wsch., x 99,8–108,0) — bohater /domy"
 },
 "konwencje": {
  "pozycja/kierunek/cel": "metry w układzie GLB; cel = pozycja + 10 m wzdłuż kierunku (kamera pozioma, gdy kierunek.y = 0 — piony równoległe).",
  "yfov": "pionowe FOV [°] dla kadru o proporcjach kadr.w/kadr.h.",
  "shift": "pionowe przesunięcie obiektywu (shift lens), ułamek wysokości kadru; + = obraz w dół (więcej nieba). three.js: po updateProjectionMatrix() camera.projectionMatrix.elements[9] += 2*shift (lub setViewOffset).",
  "near": "płaszczyzna near [m] — zastępuje przekroje i ukryte warstwy scen SketchUpa, których eksport nie przenosi.",
  "ukryj": "obiekty do ukrycia w tym ujęciu (render dewelopera ich nie pokazuje).",
  "dopasowanie": "dobre = obrys i kadr zgodne w granicach kilku %; przybliżone = ten sam widok, różnice kadru/pozycji widoczne."
 },
 "podglady": "Światło podglądu = verify.html (NeutralToneMapping, RoomEnvironment 0,6, słońce #ffe7c7 ×3, hemi 0,8). Podglądy oceniają geometrię i kadr; światło i materiały ocenia się na docelowej scenie.",
 "dom2_glb": "bor2-wnetrze-dom2.glb nie ma jeszcze w repo. Podglądy z eksportu: blender --background bor2-wnetrze-dom2.blend --python blend_to_glb.py -- bor2-wnetrze-dom2.glb (opcje domyślne, 28,8 MB).",
